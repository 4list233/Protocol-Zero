# ============================================
# Protocol Zero — Environment Variables Template
# ============================================
#
# INSTRUCTIONS:
# 1. cp .env.example .env
# 2. Fill in real values (never commit .env to git)
# 3. For local shop dev, symlink: ln -sf ../.env shop/.env.local
# 4. For Vercel, set all variables in Project → Settings → Environment Variables
#
# All .env* files are gitignored except .env.example
# ============================================

# ============================================
# KNACK DATABASE (Products, Variants, Orders, Carts, Users)
# ============================================
# Required for both the shop and the scraper uploader.
# Knack Builder → API & Code → Application ID / REST API Key
KNACK_APPLICATION_ID=your-knack-application-id
KNACK_REST_API_KEY=your-knack-rest-api-key

# Optional: override default Knack object/field keys
# (defaults are defined in shop/lib/knack-config.ts)
# KNACK_OBJECT_KEY_PRODUCTS=object_6
# KNACK_OBJECT_KEY_VARIANTS=object_7
# KNACK_OBJECT_KEY_ORDERS=object_10
# KNACK_OBJECT_KEY_CLIPS=object_11
# KNACK_OBJECT_KEY_SIGNUPS=object_12
# KNACK_OBJECT_KEY_USERS=object_8
# KNACK_OBJECT_KEY_ACCOUNTS=object_2

# ============================================
# DEEPSEEK API (Scraper translation)
# ============================================
# Required for translate_deepseek.py
# Get your key at: https://platform.deepseek.com
DEEPSEEK_API_KEY=your-deepseek-api-key

# ============================================
# FIREBASE (Authentication)
# ============================================
# Client-side Firebase config (NEXT_PUBLIC_ prefix = exposed to browser)
# Firebase Console → Project Settings → Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdefghijk
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Server-side Firebase Admin SDK (never exposed to browser)
# Firebase Console → Project Settings → Service Accounts → Generate new private key
# Paste the entire JSON object as a single-line string:
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}'

# Alternative: individual fields instead of the JSON string above
# FIREBASE_ADMIN_PROJECT_ID=your-project-id
# FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ============================================
# APPLICATION SETTINGS
# ============================================
# Base URL — set to your production domain on Vercel
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional: in-process product cache TTL in seconds (default: 300)
CACHE_TTL_SECONDS=300
